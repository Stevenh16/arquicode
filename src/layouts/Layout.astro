---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'ArquiCode — Comprende el código. Diseña mejores sistemas',
	description = 'Aprende programación orientada a objetos, principios de diseño y arquitectura de software con conceptos claros, ejemplos prácticos y código.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#f9f9f9" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		color: var(--text);
		background: var(--color-background);
		font-synthesis: none;
		text-rendering: optimizeLegibility;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		--color-primary: #445121;
		--color-secondary: #667030;
		--color-accent: #b9b890;
		--color-surface: #e0e0cd;
		--color-background: #f9f9f9;
		--color-background-rgb: 249, 249, 249;
		--color-primary-rgb: 68, 81, 33;
		--color-secondary-rgb: 102, 112, 48;
		--color-accent-rgb: 185, 184, 144;
		--color-ink: #25291c;
		--color-muted: #555844;
		--text: var(--color-ink);
		--muted: var(--color-muted);
		--subtle: var(--color-secondary);
		--accent: var(--color-secondary);
		--accent-strong: var(--color-primary);
		--line: rgba(var(--color-primary-rgb), 0.18);
		--surface: var(--color-background);
		--surface-raised: var(--color-surface);
		--content-width: 1160px;
		color-scheme: light;
		scroll-behavior: smooth;
	}

	* {
		box-sizing: border-box;
	}

	html {
		min-width: 320px;
		scroll-padding-top: 24px;
	}

	body {
		min-width: 320px;
		margin: 0;
	}

	a {
		color: inherit;
	}

	a:focus-visible,
	button:focus-visible,
	summary:focus-visible {
		outline: 2px solid var(--accent-strong);
		outline-offset: 4px;
	}

	::selection {
		color: var(--color-background);
		background: var(--color-secondary);
	}

	@media (prefers-reduced-motion: reduce) {
		:root {
			scroll-behavior: auto;
		}

		*,
		*::before,
		*::after {
			scroll-behavior: auto !important;
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
		}
	}
</style>
