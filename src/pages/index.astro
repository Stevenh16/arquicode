---
import { getCollection } from 'astro:content';
import CategoryIcon from '../components/CategoryIcon.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';
import { categories } from '../data/learning';

const lessons = (await getCollection('lessons'))
	.filter((lesson) => !lesson.data.draft)
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, 3);
const categoryTitles = new Map(categories.map((category) => [category.slug, category.title]));
---

<Layout>
	<SiteHeader />
	<main>
		<section class="hero section-wrap" id="inicio" aria-labelledby="hero-title">
			<div class="hero-copy">
				<p class="eyebrow"><span class="eyebrow-mark"></span>Aprende a diseñar software</p>
				<h1 id="hero-title">Comprende el código.<br /><span>Diseña mejores sistemas.</span></h1>
				<p class="hero-description">
					Aprende programación orientada a objetos, principios de diseño y arquitectura con conceptos
					claros, ejemplos prácticos y código que puedes entender.
				</p>
				<div class="hero-actions">
					<a class="button button-primary" href="#categorias">
						Comenzar a aprender
						<svg viewBox="0 0 20 20" aria-hidden="true">
							<path d="M4 10h12m-5-5 5 5-5 5" />
						</svg>
					</a>
					<a class="button button-secondary" href="#categorias">Explorar categorías</a>
				</div>
				<div class="hero-proof">
					<span class="proof-line"></span>
					<span>Contenido gratuito, en español y paso a paso</span>
				</div>
			</div>

			<div class="hero-visual" role="img" aria-label="Diagrama de componentes conectados en una arquitectura de software">
				<div class="visual-caption"><span></span> DISEÑO CON INTENCIÓN</div>
				<svg class="architecture-diagram" viewBox="0 0 540 430" fill="none" aria-hidden="true">
					<defs>
						<pattern id="grid" width="24" height="24" patternUnits="userSpaceOnUse">
							<circle cx="1" cy="1" r="1" fill="#b9b890" opacity=".5" />
						</pattern>
					</defs>
					<rect x="2" y="1" width="536" height="428" rx="18" fill="url(#grid)" />
					<path class="connector" d="M270 112v42m-104 0h208m-208 0v35m104-35v35m104-35v35" />
					<path class="connector connector-soft" d="M166 240v45m104-45v45m104-45v45m-208 0h208" />
					<circle cx="270" cy="154" r="3" fill="#667030" />
					<circle cx="166" cy="285" r="3" fill="#667030" />
					<circle cx="270" cy="285" r="3" fill="#667030" />
					<circle cx="374" cy="285" r="3" fill="#667030" />
					<g class="diagram-card diagram-root">
						<rect x="172" y="34" width="196" height="78" rx="12" />
						<rect class="icon-back" x="188" y="52" width="38" height="38" rx="9" />
						<path class="diagram-icon" d="m199 63-6 6 6 6m16-12 6 6-6 6m-4-14-4 16" />
						<text x="240" y="66">Sistema</text>
						<text class="diagram-subtitle" x="240" y="84">reglas y comportamiento</text>
					</g>
					<g class="diagram-card">
						<rect x="88" y="196" width="156" height="46" rx="10" />
						<circle class="node node-blue" cx="106" cy="219" r="5" />
						<text x="120" y="223">Dominio</text>
					</g>
					<g class="diagram-card">
						<rect x="192" y="196" width="156" height="46" rx="10" />
						<circle class="node node-purple" cx="210" cy="219" r="5" />
						<text x="224" y="223">Aplicación</text>
					</g>
					<g class="diagram-card">
						<rect x="296" y="196" width="156" height="46" rx="10" />
						<circle class="node node-green" cx="314" cy="219" r="5" />
						<text x="328" y="223">Infraestructura</text>
					</g>
					<g class="diagram-note">
						<rect x="105" y="314" width="122" height="40" rx="9" />
						<text x="121" y="338">Clases y objetos</text>
					</g>
					<g class="diagram-note">
						<rect x="209" y="314" width="122" height="40" rx="9" />
						<text x="227" y="338">Casos de uso</text>
					</g>
					<g class="diagram-note">
						<rect x="313" y="314" width="122" height="40" rx="9" />
						<text x="327" y="338">Adaptadores</text>
					</g>
					<text class="diagram-label" x="35" y="390">CADA PIEZA TIENE UN PROPÓSITO</text>
					<path d="M35 402h470" stroke="#b9b890" />
				</svg>
				<div class="floating-chip"><span></span> claridad antes que complejidad</div>
			</div>
		</section>

		<section class="intro-section" aria-labelledby="intro-title">
			<div class="section-wrap intro-grid">
				<div>
					<p class="eyebrow">Una forma más clara de aprender</p>
					<h2 id="intro-title">El diseño de software<br />también se aprende.</h2>
				</div>
				<div class="intro-copy">
					<p>
						ArquiCode es un espacio educativo gratuito para entender cómo se construye software
						mantenible, desde los primeros objetos hasta la arquitectura de un sistema.
					</p>
					<p>
						Los conceptos de diseño suelen presentarse de forma fragmentada o demasiado abstracta.
						Aquí los recorres paso a paso, con ejemplos en Java, diagramas, comparaciones y ejercicios
						que conectan cada idea con problemas reales.
					</p>
				</div>
			</div>
		</section>

		<section class="categories-section section-wrap" id="categorias" aria-labelledby="categories-title">
			<div class="section-heading">
				<div>
					<p class="eyebrow">Un camino para cada concepto</p>
					<h2 id="categories-title">Explora las categorías</h2>
					<p class="section-description">
						Avanza desde los fundamentos hasta las decisiones que dan forma a un sistema.
					</p>
				</div>
				<span class="category-count">06 ÁREAS DE APRENDIZAJE</span>
			</div>

			<div class="category-grid">
				{categories.map((category, index) => (
					<article class="category-card" id={category.slug} style={`--card-index: ${index}`}>
						<a class="category-card-link" href={`/categorias/${category.slug}/`}>
							<div class="category-card-top">
								<span class={`category-icon icon-${category.icon}`}>
									<CategoryIcon name={category.icon} />
								</span>
								<span class="card-arrow" aria-hidden="true">
									<svg viewBox="0 0 20 20">
										<path d="M4 10h12m-5-5 5 5-5 5" />
									</svg>
								</span>
							</div>
							<h3>{category.title}</h3>
							<p>{category.description}</p>
							<div class="card-footer">
								<span>{category.topics}</span>
								<span class="card-link-label">Explorar categoría</span>
							</div>
						</a>
					</article>
				))}
			</div>
		</section>

		<section class="method-section" aria-labelledby="method-title">
			<div class="section-wrap">
				<div class="section-heading method-heading">
					<div>
						<p class="eyebrow">Aprender haciendo conexiones</p>
						<h2 id="method-title">De la idea a la práctica</h2>
					</div>
					<p class="section-description">
						Una estructura progresiva para comprender, no solo recordar.
					</p>
				</div>
				<ol class="steps">
					<li class="step">
						<span class="step-number">01</span>
						<span class="step-icon" aria-hidden="true">
							<svg viewBox="0 0 32 32"><circle cx="14" cy="14" r="8" /><path d="m20 20 7 7m-13-13 3-3" /></svg>
						</span>
						<h3>Comprende el problema</h3>
						<p>Identifica qué situación hace necesaria una decisión de diseño.</p>
					</li>
					<li class="step">
						<span class="step-number">02</span>
						<span class="step-icon" aria-hidden="true">
							<svg viewBox="0 0 32 32"><path d="M16 4v24M4 16h24m-20-8 16 16m0-16L8 24" /><circle cx="16" cy="16" r="4" /></svg>
						</span>
						<h3>Aprende el concepto</h3>
						<p>Construye una base sólida con explicaciones claras y progresivas.</p>
					</li>
					<li class="step">
						<span class="step-number">03</span>
						<span class="step-icon" aria-hidden="true">
							<svg viewBox="0 0 32 32"><rect x="4" y="6" width="24" height="20" rx="3" /><path d="m10 13 3 3-3 3m7 0h5" /></svg>
						</span>
						<h3>Analiza el código</h3>
						<p>Compara ejemplos y observa cómo una idea cambia el diseño.</p>
					</li>
					<li class="step">
						<span class="step-number">04</span>
						<span class="step-icon" aria-hidden="true">
							<svg viewBox="0 0 32 32"><path d="m16 4 3.7 7.5 8.3 1.2-6 5.8 1.4 8.2-7.4-3.9-7.4 3.9 1.4-8.2-6-5.8 8.3-1.2L16 4Z" /></svg>
						</span>
						<h3>Practica y comprueba</h3>
						<p>Aplica lo aprendido y desarrolla tu criterio con ejercicios.</p>
					</li>
				</ol>
			</div>
		</section>

		<section class="lessons-section section-wrap" id="lecciones" aria-labelledby="lessons-title">
			<div class="section-heading">
				<div>
					<p class="eyebrow">Para seguir aprendiendo</p>
					<h2 id="lessons-title">Lecciones destacadas</h2>
				</div>
				{lessons.length > 0 && <span class="category-count">RECIÉN PUBLICADAS</span>}
			</div>
			{lessons.length > 0 ? (
				<div class="lesson-grid">
					{lessons.map((lesson) => (
						<a class="lesson-card" href={`/lecciones/${lesson.id}/`}>
							<span class="lesson-category">{categoryTitles.get(lesson.data.category)}</span>
							<h3>{lesson.data.title}</h3>
							<p>{lesson.data.description}</p>
							<span class="lesson-read">
								Leer lección
								<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" /></svg>
							</span>
						</a>
					))}
				</div>
			) : (
				<div class="empty-lessons">
					<div class="empty-icon" aria-hidden="true">
						<svg viewBox="0 0 40 40">
							<path d="M8 9.5A3.5 3.5 0 0 1 11.5 6H32v26H11.5A3.5 3.5 0 0 1 8 28.5v-19Z" />
							<path d="M8 28.5a3.5 3.5 0 0 1 3.5-3.5H32M14 13h12m-12 5h9" />
						</svg>
					</div>
					<div>
						<h3>Estamos preparando las primeras lecciones.</h3>
						<p>
							Pronto encontrarás guías y ejemplos para llevar estas ideas al código. Mientras tanto,
							puedes conocer el recorrido de cada categoría.
						</p>
					</div>
					<a href="#categorias" class="empty-link">
						Ver categorías
						<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" /></svg>
					</a>
				</div>
			)}
		</section>

		<section class="philosophy-section" aria-labelledby="philosophy-title">
			<div class="section-wrap philosophy-inner">
				<div class="philosophy-symbol" aria-hidden="true">
					<svg viewBox="0 0 72 72">
						<circle cx="36" cy="36" r="27" />
						<path d="M36 9v10m0 34v10M9 36h10m34 0h10M17 17l7 7m24 24 7 7m0-38-7 7m-24 24-7 7" />
						<circle cx="36" cy="36" r="11" />
						<path d="m32 36 3 3 6-7" />
					</svg>
				</div>
				<div>
					<p class="eyebrow">La filosofía de ArquiCode</p>
					<h2 id="philosophy-title">No se trata de memorizar.<br /><span>Se trata de saber por qué.</span></h2>
					<p>
						Un patrón no es una receta para todo problema. Lo importante es reconocer cuándo aporta
						valor, por qué funciona y cómo aplicarlo sin añadir complejidad innecesaria. Claridad,
						práctica y razonamiento están antes que cualquier fórmula.
					</p>
				</div>
			</div>
		</section>
	</main>
	<SiteFooter />
</Layout>

<style>
	.section-wrap {
		width: min(var(--content-width), calc(100% - 48px));
		margin-inline: auto;
	}

	.hero {
		min-height: 610px;
		display: grid;
		grid-template-columns: 1fr 0.93fr;
		align-items: center;
		gap: 28px;
		padding-top: 68px;
		padding-bottom: 72px;
	}

	.hero-copy {
		position: relative;
		z-index: 1;
		padding: 8px 0;
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 9px;
		margin: 0 0 19px;
		color: var(--color-primary);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.eyebrow-mark {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--color-secondary);
		box-shadow: 0 0 0 4px rgba(var(--color-accent-rgb), 0.3);
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	.hero h1 {
		margin-bottom: 23px;
		color: var(--color-ink);
		font-size: clamp(2.6rem, 5.1vw, 4.25rem);
		font-weight: 690;
		letter-spacing: -0.065em;
		line-height: 1.1;
	}

	.hero h1 span {
		color: var(--color-primary);
	}

	.hero-description {
		max-width: 520px;
		margin-bottom: 29px;
		color: var(--color-muted);
		font-size: 1.02rem;
		line-height: 1.78;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.button {
		min-height: 48px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		padding: 0 17px;
		border: 1px solid transparent;
		border-radius: 8px;
		font-size: 0.85rem;
		font-weight: 650;
		text-decoration: none;
		transition:
			transform 160ms ease,
			background 160ms ease,
			border-color 160ms ease;
	}

	.button:hover {
		transform: translateY(-2px);
	}

	.button-primary {
		color: var(--color-background);
		background: var(--color-primary);
	}

	.button-primary:hover {
		background: var(--color-secondary);
	}

	.button-primary svg,
	.empty-link svg,
	.lesson-read svg {
		width: 17px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.7;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.button-secondary {
		border-color: rgba(var(--color-secondary-rgb), 0.48);
		color: var(--color-primary);
		background: transparent;
	}

	.button-secondary:hover {
		border-color: var(--color-secondary);
		background: var(--color-surface);
	}

	.hero-proof {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-top: 34px;
		color: var(--muted);
		font-size: 0.78rem;
	}

	.proof-line {
		width: 25px;
		height: 1px;
		background: var(--accent);
	}

	.hero-visual {
		position: relative;
		width: 100%;
		max-width: 540px;
		justify-self: end;
		padding: 25px 0 20px;
	}

	.hero-visual::before {
		position: absolute;
		z-index: -1;
		top: 10%;
		left: 12%;
		width: 72%;
		height: 70%;
		border-radius: 50%;
		background: rgba(var(--color-accent-rgb), 0.32);
		content: "";
		filter: blur(48px);
	}

	.visual-caption {
		display: flex;
		align-items: center;
		gap: 8px;
		margin: 0 0 8px 18px;
		color: var(--color-muted);
		font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
		font-size: 0.63rem;
		letter-spacing: 0.12em;
	}

	.visual-caption span,
	.floating-chip span {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--color-secondary);
		box-shadow: 0 0 10px rgba(var(--color-secondary-rgb), 0.35);
	}

	.architecture-diagram {
		width: 100%;
		overflow: visible;
	}

	.connector,
	.connector-soft {
		stroke: var(--color-secondary);
		stroke-width: 1.2;
	}

	.connector-soft {
		stroke: var(--color-accent);
		stroke-dasharray: 3 5;
	}

	.diagram-card rect,
	.diagram-note rect {
		fill: var(--color-background);
		stroke: var(--color-accent);
		stroke-width: 1;
	}

	.diagram-root > rect:first-child {
		fill: var(--color-surface);
		stroke: var(--color-secondary);
	}

	.diagram-card text {
		fill: var(--color-ink);
		font-family: Inter, ui-sans-serif, system-ui, sans-serif;
		font-size: 11px;
		font-weight: 600;
	}

	.diagram-card text.diagram-subtitle {
		fill: var(--color-muted);
		font-size: 8px;
		font-weight: 400;
	}

	.diagram-root .icon-back {
		fill: var(--color-accent);
		fill-opacity: 0.42;
		stroke: var(--color-secondary);
		stroke-opacity: 0.7;
	}

	.diagram-icon {
		stroke: var(--color-primary);
		stroke-width: 1.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.node {
		fill: var(--color-primary);
	}

	.node-purple {
		fill: var(--color-secondary);
	}

	.node-green {
		fill: var(--color-accent);
	}

	.diagram-note rect {
		fill: var(--color-surface);
		stroke: var(--color-accent);
	}

	.diagram-note text {
		fill: var(--color-muted);
		font-family: Inter, ui-sans-serif, system-ui, sans-serif;
		font-size: 8px;
	}

	.diagram-label {
		fill: var(--color-secondary);
		font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
		font-size: 8px;
		letter-spacing: 0.12em;
	}

	.floating-chip {
		position: absolute;
		right: 1%;
		bottom: 2px;
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 11px 13px;
		border: 1px solid rgba(var(--color-accent-rgb), 0.7);
		border-radius: 9px;
		color: var(--color-ink);
		background: var(--color-background);
		box-shadow: 0 12px 32px rgba(var(--color-primary-rgb), 0.12);
		font-size: 0.68rem;
	}

	.intro-section,
	.method-section,
	.philosophy-section {
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		background: var(--color-surface);
	}

	.intro-grid {
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		gap: 80px;
		padding-top: 82px;
		padding-bottom: 82px;
	}

	.intro-grid h2,
	.section-heading h2,
	.philosophy-inner h2 {
		margin-bottom: 0;
		color: var(--color-ink);
		font-size: clamp(1.8rem, 3.4vw, 2.6rem);
		font-weight: 650;
		letter-spacing: -0.045em;
		line-height: 1.2;
	}

	.intro-copy {
		padding-top: 4px;
	}

	.intro-copy p {
		margin-bottom: 15px;
		color: var(--color-muted);
		font-size: 0.95rem;
		line-height: 1.8;
	}

	.intro-copy p:last-child {
		margin-bottom: 0;
		color: var(--color-primary);
		font-size: 0.88rem;
	}

	.categories-section {
		padding-top: 94px;
		padding-bottom: 100px;
	}

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 24px;
		margin-bottom: 31px;
	}

	.section-heading .eyebrow,
	.philosophy-inner .eyebrow {
		margin-bottom: 13px;
	}

	.section-description {
		max-width: 510px;
		margin: 12px 0 0;
		color: var(--muted);
		font-size: 0.91rem;
		line-height: 1.65;
	}

	.category-count {
		padding-bottom: 5px;
		color: var(--color-secondary);
		font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
		font-size: 0.65rem;
		letter-spacing: 0.1em;
		white-space: nowrap;
	}

	.category-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 15px;
	}

	.category-card {
		min-height: 251px;
		border: 1px solid rgba(var(--color-accent-rgb), 0.8);
		border-radius: 12px;
		background: var(--color-background);
		transition:
			transform 180ms ease,
			border-color 180ms ease,
			background 180ms ease;
	}

	.category-card:hover {
		transform: translateY(-3px);
		border-color: var(--color-secondary);
		background: var(--color-surface);
	}

	.category-card-link {
		height: 100%;
		display: flex;
		flex-direction: column;
		padding: 21px 21px 18px;
		text-decoration: none;
	}

	.category-card-link:focus-visible {
		border-radius: 12px;
	}

	.category-card-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 20px;
	}

	.category-icon {
		width: 46px;
		height: 46px;
		display: grid;
		place-items: center;
