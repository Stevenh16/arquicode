---
interface Props {
	name: string;
}

const { name } = Astro.props;
---

<svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
	{ name === 'layers' && (
		<>
			<path d="m16 4 12 6-12 6L4 10l12-6Z" />
			<path d="m4 16 12 6 12-6M4 22l12 6 12-6" />
		</>
	)}
	{ name === 'compass' && (
		<>
			<circle cx="16" cy="16" r="12" />
			<path d="m20.5 11.5-3 6-6 3 3-6 6-3Z" />
		</>
	)}
	{ name === 'blocks' && (
		<>
			<rect x="4" y="4" width="10" height="10" rx="2" />
			<rect x="18" y="4" width="10" height="10" rx="2" />
			<rect x="4" y="18" width="10" height="10" rx="2" />
			<rect x="18" y="18" width="10" height="10" rx="2" />
		</>
	)}
	{ name === 'nodes' && (
		<>
			<circle cx="16" cy="6" r="3" />
			<circle cx="7" cy="24" r="3" />
			<circle cx="25" cy="24" r="3" />
			<path d="m14.7 8.7-6.4 12.6m9 0 6.4-12.6M10 24h12" />
		</>
	)}
	{ name === 'architecture' && (
		<>
			<rect x="4" y="4" width="24" height="7" rx="2" />
			<rect x="4" y="14" width="24" height="7" rx="2" />
			<rect x="4" y="24" width="24" height="4" rx="1.5" />
			<path d="M8 7.5h.01M8 17.5h.01" />
		</>
	)}
	{ name === 'terminal' && (
		<>
			<rect x="3" y="5" width="26" height="22" rx="3" />
			<path d="m9 13 4 3-4 3m7 0h7" />
		</>
	)}
</svg>

<style>
	svg {
		width: 28px;
		height: 28px;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
</style>
